# Development container - PROPERLY SETUP for Vite HMR
FROM node:22-alpine

# Install bash and other utilities for development
RUN apk add --no-cache bash git

# Create non-root user for security (use standard node user)
# Note: node:22-alpine already has node user with uid 1000

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with clean slate
RUN npm ci

# Copy configuration files
COPY tsconfig*.json ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY vite.config.ts ./
COPY eslint.config.js ./
COPY jsconfig.json ./
COPY types.d.ts ./

# Copy static files
COPY index.html ./
COPY public/ ./public/

# Copy source code (will be overridden by volume mount in development)
COPY src/ ./src/

# Change ownership to node user (uid 1000)
RUN chown -R node:node /app
USER node

EXPOSE 3000

# Development server with proper environment
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]