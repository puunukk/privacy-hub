# Multi-stage build for Privacy Hub Frontend
# Builds optimized static files for production deployment
FROM node:22-alpine as build

WORKDIR /app

# Copy package files first for better Docker layer caching
COPY package*.json ./
COPY tsconfig*.json ./  
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY vite.config.ts ./
COPY eslint.config.js ./
COPY jsconfig.json ./

# Install ALL dependencies including dev dependencies (needed for build)
RUN npm ci --silent

# Copy all source files
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./
COPY types.d.ts ./

# Set production environment for optimal build
ENV NODE_ENV=production
# These are overridden by docker-compose build args
ENV VITE_API_BASE_URL=/pi-system
ENV VITE_DOCKER_API_BASE_URL=/docker-api
ENV VITE_BASE_URL=/dashboard/

# Build the application - generates optimized static files  
# Skip strict TypeScript checks for production build, let Vite handle TypeScript
RUN npx vite build

# Verify build output exists
RUN ls -la /app/dist && echo "Build completed successfully"

# Final stage - just the static files
FROM alpine:latest as static-files

# Create output directory structure
RUN mkdir -p /static-files

# Copy built static files from build stage  
COPY --from=build /app/dist /static-files

# Add build metadata
RUN echo "Frontend built on $(date)" > /static-files/build-info.txt

# Container stays alive for copying files out
CMD ["sh", "-c", "echo 'Static files ready in /static-files' && tail -f /dev/null"]