# Privacy Hub Environment Configuration
# Copy this file to .env and customize the values

# Server configuration (auto-detected during setup)
SERVER_IP=192.168.1.100

# Timezone for logs and scheduling
TZ=Europe/Tallinn

# Pi-hole admin password (auto-generated during setup)
PIHOLE_PASSWORD=secure123

# SearXNG Configuration
SEARXNG_SECRET_KEY=auto-generated-during-setup
SEARXNG_DEFAULT_THEME=simple
SEARXNG_SAFE_SEARCH=1
SEARXNG_DEFAULT_LANG=en

# Docker Compose project name (optional)
COMPOSE_PROJECT_NAME=privacy-hub

# Hostname settings for local access
HOSTNAME=otsi
LOCAL_DOMAIN=local

# These combine to create: otsi.local, pihole.local, etc.