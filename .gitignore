# Environment variables and secrets
.env

# Keep the example file
!.env.example

# ================================
# CENTRALIZED DIRECTORY STRUCTURE  
# ================================

# All logs go to logs/ directory - ignore contents but keep structure
logs/*
!logs/.gitkeep
!logs/*/
!logs/*/.gitkeep

# All build outputs and data go to data/ directory - ignore contents but keep structure  
data/*
!data/.gitkeep
!data/*/
!data/*/.gitkeep

# ================================
# SERVICE-SPECIFIC IGNORES
# ================================

# Runtime service data (legacy paths - gradually migrate to data/)
pihole/data/
searxng/data/
nginx/ssl/

# Backup files
backups/

# Docker volumes and temporary files
docker-compose.override.yml

# Legacy scattered log files (gradually migrate to logs/)
*.log
*.tmp

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db

# Keep configuration templates but ignore generated files
#!pihole/custom.list
#!searxng/settings.yml
#!nginx/nginx.conf
#!scripts/

# ================================
# BUILD ARTIFACTS & DEPENDENCIES
# ================================

# Node.js dependencies (any level)
node_modules/
**/node_modules/

# Build artifacts (legacy - new builds should go to data/)
dist/
**/dist/
build/
**/build/
out/
tmp/
**/tmp/

# Framework/tool caches
.cache/
**/.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
.angular/

# Package managers
.npm/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python virtualenvs and caches (if present)
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.localfrontend/core
