# Privacy Hub Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Server IP address (REQUIRED - set to your Pi's static IP)
SERVER_IP=192.168.1.100

# Domain name for SSL certificate and NGINX
DOMAIN_NAME=privacy-hub.local

# Local domain suffix
LOCAL_DOMAIN=local

# Timezone for all services
TZ=Europe/Tallinn

# =============================================================================
# PIHOLE CONFIGURATION  
# =============================================================================

# Pi-hole admin password (auto-generated if not set)
PIHOLE_PASSWORD=

# Upstream DNS servers for Pi-hole
PIHOLE_DNS=1.1.1.1;1.0.0.1

# Pi-hole container name (for host NGINX to reach)
PIHOLE_CONTAINER_NAME=privacy_hub_pihole

# Pi-hole Dockerfile to use (Dockerfile, Dockerfile.pi, etc.)
PIHOLE_DOCKERFILE=Dockerfile

# =============================================================================
# SEARXNG CONFIGURATION
# =============================================================================

# SearXNG secret key (auto-generated if not set)
SEARXNG_SECRET_KEY=

# SearXNG default theme (simple, oscar, etc.)
SEARXNG_DEFAULT_THEME=simple

# Safe search setting (0=off, 1=moderate, 2=strict)
SEARXNG_SAFE_SEARCH=1

# Default language
SEARXNG_DEFAULT_LANG=en

# Performance settings for SearXNG
SEARXNG_WORKERS=2
SEARXNG_THREADS=2

# SearXNG container name
SEARXNG_CONTAINER_NAME=privacy_hub_searxng

# SearXNG Dockerfile to use
SEARXNG_DOCKERFILE=Dockerfile

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Go backend container name
BACKEND_CONTAINER_NAME=privacy_hub_go_backend

# Backend port (internal container port)
BACKEND_PORT=8080

# Backend Dockerfile to use (Dockerfile, Dockerfile.build, etc.)
BACKEND_DOCKERFILE=Dockerfile.build

# Target architecture for backend build
TARGET_ARCH=arm64

# Build metadata
VERSION=1.0.0
BUILD_TIME=
GIT_COMMIT=

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend builder container name
FRONTEND_BUILDER_CONTAINER_NAME=privacy_hub_frontend_builder

# Frontend path in NGINX (URL path)
FRONTEND_PATH=/manage

# Frontend document root on host system
FRONTEND_ROOT=/var/www/privacy-hub

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================

# NGINX config generator container name
NGINX_CONFIG_CONTAINER_NAME=privacy_hub_nginx_config

# SSL certificate paths on host system
SSL_CERT_PATH=/etc/nginx/ssl/server.crt
SSL_KEY_PATH=/etc/nginx/ssl/server.key

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker proxy container name
DOCKER_PROXY_CONTAINER_NAME=privacy_hub_docker_proxy

# Docker proxy log level (info, debug, error)
DOCKER_PROXY_LOG_LEVEL=info

# Redis container name
REDIS_CONTAINER_NAME=privacy_hub_redis

# Network names
EXTERNAL_NETWORK=privacy_hub_external
INTERNAL_NETWORK=privacy_hub_internal

# =============================================================================
# DEVELOPMENT CONFIGURATION (for docker-compose.dev.yml)
# =============================================================================

# Development ports (expose containers for direct access)
PIHOLE_DEV_PORT=8080
SEARXNG_DEV_PORT=8081
BACKEND_DEV_PORT=8082
FRONTEND_DEV_PORT=3000

# Development container names (suffixed with _dev)
NGINX_CONTAINER_NAME=privacy_hub_nginx_dev
FRONTEND_CONTAINER_NAME=privacy_hub_frontend_dev

# =============================================================================
# LEGACY COMPATIBILITY (for existing scripts)
# =============================================================================

# Docker Compose project name (optional)
COMPOSE_PROJECT_NAME=privacy-hub

# Hostname settings for local access (legacy)
HOSTNAME=otsi

# =============================================================================
# NOTES
# =============================================================================

# 1. SERVER_IP is required and should be your Pi's static IP address
# 2. DOMAIN_NAME should resolve to SERVER_IP in your local DNS/hosts file
# 3. Empty passwords will be auto-generated during setup
# 4. Container names must be unique and follow Docker naming conventions
# 5. For production, use docker-compose.pi.yml
# 6. For development, use docker-compose.dev.yml
# 7. To build frontend/config: docker-compose --profile build up
# 8. Architecture defaults to arm64 for Raspberry Pi 4/5