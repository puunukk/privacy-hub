# Show main menu
show_main_menu() {
    clear
    print_menu_header "Privacy Hub Management"
    
    echo -e "${BLUE}📊 Quick Status:${NC}"
    if load_env 2>/dev/null; then
        echo -e "   Server: ${GREEN}$SERVER_IP${NC} | Services: $(check_services_status >/dev/null 2>&1 && echo -e "${GREEN}Running${NC}" || echo -e "${RED}Issues${NC}")"
    else
        echo -e "   ${YELLOW}Not configured - run ./configure first${NC}"
    fi
    
    echo ""
    print_separator
    echo ""
    
    print_menu_item "1" "Service Management" "⚙️"
    print_menu_item "2" "Status & Monitoring" "📊"
    print_menu_item "3" "Security & Authentication" "🔐"
    print_menu_item "4" "Network & Connectivity" "🌐"
    print_menu_item "5" "Configuration & Settings" "⚙️"
    print_menu_item "6" "Maintenance & Troubleshooting" "🔧"
    print_menu_item "7" "Information & Help" "ℹ️"
    
    echo ""
    print_separator
    print_menu_item "q" "Quit" "🚪"
    echo ""
}

# Service Management Menu
service_management_menu() {
    while true; do
        clear
        print_menu_header "Service Management"
        
        print_menu_item "1" "Start All Services" "▶️"
        print_menu_item "2" "Stop All Services" "⏹️"
        print_menu_item "3" "Restart All Services" "🔄"
        print_menu_item "4" "Update Container Images" "🔄"
        print_menu_item "5" "Rebuild All Services" "🔨"
        print_menu_item "6" "Individual Service Control" "⚙️"
        print_menu_item "7" "View Service Logs" "📋"
        
        echo ""
        print_separator
        print_menu_item "b" "Back to Main Menu" "⬅️"
        echo ""
        
        echo -n -e "${BLUE}❓ Select option: ${NC}"
        read -r choice
        
        case "$choice" in
            1) 
                clear
                start_services
                press_enter
                ;;
            2) 
                clear
                if confirm "Are you sure you want to stop all services?"; then
                    stop_services
                fi
                press_enter
                ;;
            3) 
                clear
                restart_services
                press_enter
                ;;
            4) 
                clear
                if confirm "This will update container images and restart services. Continue?"; then
                    update_containers
                fi
                press_enter
                ;;
            5) 
                clear
                if confirm "This will rebuild all containers. Continue?"; then
                    rebuild_services
                fi
                press_enter
                ;;
            6) individual_service_menu ;;
            7) logs_menu ;;
            b|B) return ;;
            *) print_error "Invalid option" && sleep 1 ;;
        esac
    done
}

