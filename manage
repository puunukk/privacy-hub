# Helper functions for info menu
show_access_info() {
    print_header "Access Information"
    
    if load_env; then
        echo ""
        echo -e "${BLUE}🌐 Web Interfaces:${NC}"
        echo -e "   🔍 Private Search:  ${GREEN}https://$SERVER_IP/${NC}"
        echo -e "   🛡️  Pi-hole Admin:   ${GREEN}https://$SERVER_IP/admin${NC}"
        echo -e "   ❤️  Health Check:    ${GREEN}https://$SERVER_IP/health${NC}"
        echo ""
        echo -e "   🌐 Hostname Access:  ${GREEN}https://$HOSTNAME.$LOCAL_DOMAIN${NC}"
        echo ""
        echo -e "${BLUE}🔑 Authentication:${NC}"
        echo -e "   Pi-hole Password: ${GREEN}$PIHOLE_PASSWORD${NC}"
        echo ""
        echo -e "${BLUE}📝 Router Configuration:${NC}"
        echo -e "   Set router DNS to: ${GREEN}$SERVER_IP${NC}"
        echo -e "   All devices will use privacy-protected DNS"
    else
        print_error "Environment not configured - run ./configure first"
    fi
}

show_version_info() {
    print_header "Version Information"
    
    echo ""
    echo -e "${BLUE}🐳 Docker Environment:${NC}"
    echo "   Docker: $(docker --version | cut -d' ' -f3 | cut -d',' -f1)"
    echo "   Docker Compose: $(docker compose version --short)"
    echo ""
    
    echo -e "${BLUE}🛡️ Privacy Hub Services:${NC}"
    if docker compose ps --services --filter "status=running" | grep -q pihole; then
        local pihole_version=$(docker exec pihole pihole version | grep "Pi-hole version" | cut -d' ' -f3 2>/dev/null || echo "Unknown")
        echo "   Pi-hole: $pihole_version"
    else
        echo "   Pi-hole: Not running"
    fi
    
    if docker compose ps --services --filter "status=running" | grep -q nginx; then
        echo "   NGINX: $(docker exec nginx nginx -v 2>&1 | cut -d' ' -f3 | cut -d'/' -f2)"
    else
        echo "   NGINX: Not running"
    fi
    
    if docker compose ps --services --filter "status=running" | grep -q searxng; then
        echo "   SearXNG: Latest"
    else
        echo "   SearXNG: Not running"
    fi
}

