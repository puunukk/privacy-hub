    free -h | grep -E "(Mem|Swap):"
    echo ""
    
    echo -e "${BLUE}💽 Disk Usage:${NC}"
    df -h / | tail -1
    echo ""
    
    if load_env; then
        echo -e "${BLUE}🌐 Network:${NC}"
        echo "   Server IP: $SERVER_IP"
        echo "   Hostname: $HOSTNAME.$LOCAL_DOMAIN"
    fi
}

# Command-line argument handling for backwards compatibility
handle_cli_args() {
    case "${1:-help}" in
        "status"|"st") clear; check_services_status; exit 0 ;;
        "logs"|"log") clear; show_logs "$2"; exit 0 ;;
        "restart"|"r") clear; restart_services; exit 0 ;;
        "start") clear; start_services; exit 0 ;;
        "stop") clear; stop_services; exit 0 ;;
        "update") clear; update_containers; exit 0 ;;
        "password"|"pass") clear; reset_pihole_password; exit 0 ;;
        "ssl"|"cert") clear; upgrade_to_trusted_cert; exit 0 ;;
        "diagnose"|"diag") clear; run_network_diagnostics; exit 0 ;;
        "info"|"i") clear; show_access_info; exit 0 ;;
        "help"|"h") show_cli_help; exit 0 ;;
        "") ;; # No arguments - show interactive menu
        *) print_error "Unknown command: $1"; show_cli_help; exit 1 ;;
    esac
}

show_cli_help() {
    print_header "Privacy Hub Management"
    echo ""
    echo -e "${BLUE}🎯 Interactive Mode:${NC}"
    echo -e "   ${GREEN}./manage${NC}           Show interactive menu"
    echo ""
    echo -e "${BLUE}⚡ Quick Commands:${NC}"
    echo -e "   ${GREEN}./manage status${NC}     Show service status"
    echo -e "   ${GREEN}./manage restart${NC}    Restart all services"
    echo -e "   ${GREEN}./manage update${NC}     Update container images"
    echo -e "   ${GREEN}./manage password${NC}   Reset Pi-hole password"
    echo -e "   ${GREEN}./manage ssl${NC}        Upgrade SSL certificates"
    echo -e "   ${GREEN}./manage diagnose${NC}   Run network diagnostics"
    echo -e "   ${GREEN}./manage info${NC}       Show access information"
    echo ""
    echo -e "${BLUE}💡 Tip:${NC} Run ${GREEN}./manage${NC} without arguments for the full interactive menu"
}

# Main function
main() {
    # Handle command-line arguments
    if [ $# -gt 0 ]; then
        handle_cli_args "$@"
    fi
    
    # Interactive menu mode
    while true; do
        show_main_menu
        
        echo -n -e "${BLUE}❓ Select option: ${NC}"
        read -r choice
        
        case "$choice" in
            1) service_management_menu ;;
            2) status_monitoring_menu ;;
            3) security_menu ;;
            4) network_menu ;;
            5) configuration_menu ;;
            6) maintenance_menu ;;
            7) info_help_menu ;;
            q|Q|quit|exit) 
                clear
                print_success "Thank you for using Privacy Hub!"
                echo "Your privacy-protected network is still running."
                exit 0 
                ;;
            *) print_error "Invalid option" && sleep 1 ;;
        esac
    done
}

# Run main function
main "$@"