# Build-only Dockerfile for creating standalone binary
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go files
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

# Download dependencies and build standalone binary
RUN go mod download && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o privacy-hub-backend cmd/main.go

# Create a minimal runtime image just for extracting the binary
FROM alpine:latest AS extractor

# Copy binary from build stage
COPY --from=builder /app/privacy-hub-backend /privacy-hub-backend

# Create output directory and copy binary
RUN mkdir -p /output
CMD ["cp", "/privacy-hub-backend", "/output/"]
