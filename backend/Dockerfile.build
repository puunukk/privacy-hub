# Build stage for Linux service
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go files
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

# Download dependencies and build for Linux ARM64 (Raspberry Pi)
RUN go mod download && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o privacy-hub-backend cmd/main.go

# Simple runtime stage that just holds the binary
FROM alpine:latest

# Copy binary from build stage
COPY --from=builder /app/privacy-hub-backend /privacy-hub-backend

# Make executable
RUN chmod +x /privacy-hub-backend

# Just keep the container running with the binary available
CMD ["sleep", "infinity"]
