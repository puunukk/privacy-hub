[Unit]
Description=Privacy Hub Backend Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/privacy-hub-backend
ExecStart=/opt/privacy-hub-backend/privacy-hub-backend
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=privacy-hub-backend

# Security settings - relaxed for system management
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=false
ProtectHome=false
ReadWritePaths=/proc /sys /etc /usr/bin /usr/sbin

[Install]
WantedBy=multi-user.target
