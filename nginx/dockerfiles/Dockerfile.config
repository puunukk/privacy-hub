# NGINX Host Configuration Generator
# Purpose: Generates host NGINX configuration using environment variables
# Used by: docker-compose.host.yml for system NGINX deployment
# Features: Template-based config generation for host deployment

FROM alpine:latest

# Install envsubst (gettext package)
RUN apk add --no-cache gettext

WORKDIR /config

# Copy the host production template
COPY configs/host-production.conf /templates/host-nginx.conf

# Default environment variables for host deployment
ENV DOMAIN_NAME=privacy-hub.local \
    SERVER_IP=192.168.1.100 \
    FRONTEND_ROOT=/var/www/privacy-hub \
    SSL_CERT_PATH=/etc/letsencrypt/live/DOMAIN_NAME/fullchain.pem \
    SSL_KEY_PATH=/etc/letsencrypt/live/DOMAIN_NAME/privkey.pem \
    PIHOLE_CONTAINER_NAME=privacy_hub_pihole \
    SEARXNG_CONTAINER_NAME=privacy_hub_searxng \
    BACKEND_CONTAINER_NAME=privacy_hub_go_backend \
    BACKEND_PORT=8111 \
    DOCKER_PROXY_CONTAINER_NAME=privacy_hub_docker_proxy

# Generate configuration and output to mounted volume
CMD envsubst '$$DOMAIN_NAME $$SERVER_IP $$FRONTEND_ROOT $$SSL_CERT_PATH $$SSL_KEY_PATH' < /templates/host-nginx.conf > /config/nginx.conf && \
    echo "Host NGINX configuration generated successfully" && \
    echo "Configuration saved to /config/nginx.conf" && \
    echo "========================================" && \
    echo "Generated config preview:" && \
    echo "========================================" && \
    head -20 /config/nginx.conf && \
    echo "========================================"