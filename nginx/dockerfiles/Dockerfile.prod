# NGINX Production Container
# Purpose: Production environment serving static frontend files
# Used by: docker-compose.pi-prod.yml
# Features: Static file serving, full SSL, security headers, performance optimizations

FROM nginx:alpine

# Install curl and other production utilities
RUN apk add --no-cache curl gzip brotli

# Copy modular nginx configuration structure
COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/ /etc/nginx/conf.d/
COPY sites-available/ /etc/nginx/sites-available/  
COPY sites-enabled/ /etc/nginx/sites-enabled/

# Copy error pages and static files
COPY html/ /usr/share/nginx/html/

# Copy SSL certificates for production
COPY ssl/ /etc/nginx/ssl/

# Create directory for static files
RUN mkdir -p /var/www/privacy-hub

# Frontend files are provided via volume mount or copied separately
# The frontend_builder service handles building and placing files in ./data/nginx/html
# which gets mounted to /var/www/privacy-hub at runtime

# Fix permissions for mounted volumes and SSL certificates
# The logs and SSL will be mounted from host, so we need proper permissions
RUN mkdir -p /var/log/nginx /var/www/privacy-hub /etc/nginx/ssl && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /var/www/privacy-hub /etc/nginx/ssl

# Production optimizations
RUN echo 'worker_rlimit_nofile 65535;' >> /etc/nginx/nginx.conf

# Security hardening
RUN rm -rf /etc/nginx/conf.d/default.conf && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

# Health check for production
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Expose ports
EXPOSE 80 443 53

# Run as root to handle mounted volumes with different permissions
# In production, this is acceptable for proxy containers
USER root

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]