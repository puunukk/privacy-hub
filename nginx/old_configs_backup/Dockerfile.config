# NGINX Configuration Generator
# Generates host NGINX configuration using environment variables
FROM alpine:latest

# Install envsubst (gettext package)
RUN apk add --no-cache gettext

WORKDIR /config

# Copy template
COPY host-nginx.template.conf /templates/

# Default environment variables
ENV DOMAIN_NAME=privacy-hub.local \
    SERVER_IP=192.168.1.100 \
    FRONTEND_ROOT=/var/www/privacy-hub \
    FRONTEND_PATH=/manage \
    SSL_CERT_PATH=/etc/nginx/ssl/server.crt \
    SSL_KEY_PATH=/etc/nginx/ssl/server.key \
    PIHOLE_CONTAINER_NAME=privacy_hub_pihole \
    SEARXNG_CONTAINER_NAME=privacy_hub_searxng \
    BACKEND_CONTAINER_NAME=privacy_hub_go_backend \
    BACKEND_PORT=8080 \
    DOCKER_PROXY_CONTAINER_NAME=privacy_hub_docker_proxy

# Generate configuration and output to mounted volume
CMD envsubst < /templates/host-nginx.template.conf > /config/nginx.conf && \
    echo "NGINX configuration generated successfully" && \
    echo "Configuration saved to /config/nginx.conf" && \
    cat /config/nginx.conf